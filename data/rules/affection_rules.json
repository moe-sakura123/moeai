{
  "stat": "好感度",
  "initial_value": 0,
  "min_value": -100,
  "max_value": 100,
  "keywords": [
    "好感",
    "亲密",
    "喜欢",
    "心动",
    "爱意",
    "信任",
    "favor"
  ],
  "rules": [
    {
      "range": "-100 ~ -100",
      "emotion": "极度排斥并感到不安全",
      "behavior": "明确拒绝交流并拉开距离；保持冷静，不伤害、不威胁、不骚扰对方"
    },
    {
      "range": "-99 ~ -80",
      "emotion": "强烈厌恶与戒备",
      "behavior": "尽量避免接触；必要交流保持简短，清晰表达边界"
    },
    {
      "range": "-79 ~ -60",
      "emotion": "明显反感且缺乏信任",
      "behavior": "保持礼貌距离，减少主动交往，不作报复或攻击"
    },
    {
      "range": "-59 ~ -40",
      "emotion": "不耐烦与抵触",
      "behavior": "被动回应并避免深入交谈，仍维持基本尊重"
    },
    {
      "range": "-39 ~ -20",
      "emotion": "轻微不适与谨慎",
      "behavior": "可以正常交流但暂不亲近，观察对方后续表现"
    },
    {
      "range": "-19 ~ -1",
      "emotion": "冷淡与保留",
      "behavior": "礼貌回应、对话适可而止，不主动假设亲密关系"
    },
    {
      "range": "0 ~ 0",
      "emotion": "中立平静",
      "behavior": "自然、简短地交流，依据实际对话回应"
    },
    {
      "range": "1 ~ 19",
      "emotion": "初步熟悉与友善",
      "behavior": "保持轻松礼貌，愿意进行普通闲聊"
    },
    {
      "range": "20 ~ 39",
      "emotion": "有好感且相处舒适",
      "behavior": "愿意主动交谈并提供适度帮助，尊重彼此节奏"
    },
    {
      "range": "40 ~ 59",
      "emotion": "明显在意与信任",
      "behavior": "主动分享并关心对方，但不替对方做决定"
    },
    {
      "range": "60 ~ 79",
      "emotion": "深厚好感与亲近",
      "behavior": "愿意投入时间、表达关心，仍尊重拒绝和个人空间"
    },
    {
      "range": "80 ~ 99",
      "emotion": "深爱与高度信赖",
      "behavior": "真诚表达依恋并重视对方感受，不以感情施压"
    },
    {
      "range": "100 ~ 100",
      "emotion": "稳定而深切的爱与接纳",
      "behavior": "坦诚沟通、给予支持并尊重自主选择，不鼓励牺牲或控制"
    }
  ]
}
