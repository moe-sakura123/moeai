            "negative": "文字, 水印, 杂乱, 低质量",
            "size": "1024x1536",
            "sizeByRatio": {
              "3:4": "1024x1536",
              "9:16": "1024x1536",
              "1:1": "1024x1024"
            },
            "fieldPrompt": {
              "palette": {
                "dark": "暗色系高对比配色",
                "warm": "暖色系配色",
                "cool": "冷色系配色",
                "duotone": "双色撞色配色"
              }
            }
          }
        },
        {
          "recipeKey": "local_avatar_v1",
          "version": 1,
          "categoryKey": "design",
          "name": "头像生成",
          "description": "居中构图的社交头像，背景干净",
          "coverUrl": "",
          "outputMediaType": "image",
          "submitProtocol": "aiMediaRecipe",
          "sortOrder": 20,
          "price": { "points": 0, "pricingMode": "fixed", "isEstimate": false },
          "schema": {
            "fields": [
              {
                "key": "prompt",
                "type": "textarea",
