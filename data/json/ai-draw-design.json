              {
                "key": "palette",
                "type": "select",
                "label": "配色倾向",
                "required": false,
                "defaultValue": "dark",
                "options": [
                  { "value": "dark", "label": "暗色系" },
                  { "value": "warm", "label": "暖色系" },
                  { "value": "cool", "label": "冷色系" },
                  { "value": "duotone", "label": "双色撞色" }
                ]
              }
            ],
            "mediaSlots": []
          },
          "local": {
            "promptPrefix": "平面海报设计，主体突出，留白构图，",
